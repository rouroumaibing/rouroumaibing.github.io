<% if (breadcrumbs && breadcrumbs.length) { %>
<nav class="text-sm text-gray-500 dark:text-gray-400 mb-2">
  <% breadcrumbs.forEach(function(crumb, i) { %>
    <% if (i > 0) { %><span class="mx-2">/</span><% } %>
    <% if (i < breadcrumbs.length - 1) { %>
      <a href="<%- url_for(crumb.url) %>" class="hover:text-blue-600 dark:hover:text-blue-400"><%= crumb.name %></a>
    <% } else { %>
      <%= crumb.name %>
    <% } %>
  <% }); %>
</nav>
<% } %>
<h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white mt-4"><%= title %></h1>
<% if (typeof subtitle !== 'undefined' && subtitle) { %>
<p class="text-gray-600 dark:text-gray-400 mt-2"><%= subtitle %></p>
<% } %>
