<div id="search-modal" class="fixed inset-0 z-[100] hidden" role="dialog" aria-modal="true" aria-label="Search">
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" data-close-modal></div>
  <div class="relative w-full max-w-2xl mx-auto mt-20 bg-white dark:bg-gray-900 rounded-xl shadow-2xl overflow-hidden">
    <input type="text" id="search-input" placeholder="<%= __('search_placeholder') %>" class="w-full px-4 py-4 text-lg border-0 focus:ring-0 focus:outline-none bg-transparent" autocomplete="off">
    <div id="search-results" class="max-h-96 overflow-y-auto border-t border-gray-200 dark:border-gray-800"></div>
    <div class="flex items-center justify-between px-4 py-2 text-xs text-gray-500 border-t border-gray-200 dark:border-gray-800">
      <div class="flex items-center space-x-4">
        <span class="flex items-center space-x-1"><kbd class="px-1.5 py-0.5 border border-gray-300 dark:border-gray-700 rounded">&uarr;&darr;</kbd><span><%= __('search_navigate') %></span></span>
        <span class="flex items-center space-x-1"><kbd class="px-1.5 py-0.5 border border-gray-300 dark:border-gray-700 rounded">Enter</kbd><span><%= __('search_open') %></span></span>
      </div>
      <span class="flex items-center space-x-1"><kbd class="px-1.5 py-0.5 border border-gray-300 dark:border-gray-700 rounded">Esc</kbd><span><%= __('search_close') %></span></span>
    </div>
  </div>
</div>
