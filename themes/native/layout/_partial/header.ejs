<header class="<%= theme.navbar.sticky !== false ? 'sticky top-0' : '' %> z-50 bg-white/80 dark:bg-gray-950/80 backdrop-blur-lg border-b border-gray-200 dark:border-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
    <!-- Left: Logo + Site Name -->
    <a href="<%- url_for('/') %>" class="flex items-center space-x-3">
      <% if (theme.navbar.logo) { %>
      <img src="<%- url_for(theme.navbar.logo) %>" alt="<%= theme.navbar.site_name || config.author || config.title %>" class="h-8 w-8">
      <% } %>
      <span class="font-bold text-lg"><%= theme.navbar.site_name || config.author || config.title %></span>
    </a>

    <!-- Center: Desktop Nav -->
    <nav class="hidden lg:flex items-center space-x-1">
      <% if (theme.navbar.menu && theme.navbar.menu.length) { theme.navbar.menu.forEach(function(menu_item) { %>
        <% var menuTitle = menu_item.title_key ? __(menu_item.title_key) : menu_item.title; %>
        <% if (menu_item.type === 'dropdown') { %>
          <div class="group relative">
            <button class="px-3 py-2 rounded-lg text-sm font-medium hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors flex items-center" aria-haspopup="true" aria-expanded="false">
              <%= menuTitle %>
              <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <%- partial('_partial/mega-menu', { menu_item: menu_item }) %>
          </div>
        <% } else { %>
          <a href="<%- url_for(menu_item.url) %>" class="px-3 py-2 rounded-lg text-sm font-medium hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"><%= menuTitle %></a>
        <% } %>
      <% }); } %>
    </nav>

    <!-- Right: Controls -->
    <div class="flex items-center space-x-2">
      <!-- Search button -->
      <% if (theme.search && theme.search.enable) { %>
      <button class="hidden lg:flex items-center space-x-2 px-3 py-1.5 rounded-lg border border-gray-200 dark:border-gray-800 text-sm text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" data-modal-toggle="search-modal" aria-label="Search">
        <span><%= __('search') %></span>
        <kbd class="font-mono text-xs" id="search-shortcut"><%= theme.search.shortcut || '⌘K' %></kbd>
      </button>
      <% } %>

      <!-- i18n switcher -->
      <% if (theme.i18n && theme.i18n.enable) { %>
      <div class="hidden lg:flex items-center">
        <% var currentLang = config.language || (theme.i18n && theme.i18n.default_lang) || 'zh-CN'; %>
      <% theme.i18n.languages.forEach(function(lang, idx) { %>
          <% if (idx > 0) { %><span class="text-gray-300 dark:text-gray-600">|</span><% } %>
          <% if (currentLang === lang.code) { %>
            <span class="px-2 py-1 text-sm text-blue-600 dark:text-blue-400 font-medium"><%= lang.name %></span>
          <% } else { %>
            <a href="<%- url_for('/' + lang.code + '/') %>" class="px-2 py-1 text-sm text-gray-500 hover:text-gray-900 dark:hover:text-gray-100 transition-colors"><%= lang.name %></a>
          <% } %>
        <% }); %>
      </div>
      <% } %>

      <!-- Theme toggle -->
      <button id="theme-toggle" class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" aria-label="Toggle theme">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
      </button>

      <!-- Mobile hamburger -->
      <button class="lg:hidden p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" id="mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div id="mobile-drawer" class="hidden fixed inset-0 z-50 lg:hidden">
    <div class="absolute inset-0 bg-black/50" data-drawer-backdrop></div>
    <div class="absolute left-0 top-0 h-full w-80 max-w-[80vw] bg-white dark:bg-gray-950 overflow-y-auto p-4">
      <% if (theme.search && theme.search.enable) { %>
      <button class="w-full flex items-center space-x-2 px-3 py-2 mb-2 rounded-lg border border-gray-200 dark:border-gray-800 text-sm text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" data-modal-toggle="search-modal" aria-label="Search">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <span><%= __('search') %></span>
      </button>
      <% } %>
      <% if (theme.navbar.menu && theme.navbar.menu.length) { theme.navbar.menu.forEach(function(menu_item) { %>
        <% var menuTitle = menu_item.title_key ? __(menu_item.title_key) : menu_item.title; %>
        <% if (menu_item.type === 'dropdown') { %>
          <div class="mb-2">
            <button class="w-full flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" data-drawer-submenu-toggle aria-expanded="false">
              <%= menuTitle %>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="hidden pl-4 mt-1 space-y-1">
              <% menu_item.children.forEach(function(child) { %>
                <a href="<%- url_for(child.url) %>" class="block px-3 py-2 rounded-lg text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"<% if (child.external) { %> target="_blank" rel="noopener noreferrer"<% } %>><%= child.name %></a>
              <% }); %>
            </div>
          </div>
        <% } else { %>
          <a href="<%- url_for(menu_item.url) %>" class="block px-3 py-2 rounded-lg text-sm font-medium hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"><%= menuTitle %></a>
        <% } %>
      <% }); } %>
    </div>
  </div>
</header>
