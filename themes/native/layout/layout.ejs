<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>" class="scroll-smooth">
<head>
  <%- partial('_partial/head') %>
</head>
<body class="bg-gray-50 text-gray-900 dark:bg-gray-950 dark:text-gray-100 font-sans antialiased flex flex-col min-h-screen">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[200] focus:bg-white focus:px-4 focus:py-2 focus:rounded">Skip to content</a>

  <% if (theme.announcement && theme.announcement.enable) { %>
    <%- partial('_partial/announcement') %>
  <% } %>

  <%- partial('_partial/header') %>

  <main id="main-content" class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <%- body %>
  </main>

  <%- partial('_partial/footer') %>
  <% if (theme.search && theme.search.enable) { %>
  <%- partial('_partial/search-modal') %>
  <% } %>
  <%- partial('_partial/scripts') %>
</body>
</html>
